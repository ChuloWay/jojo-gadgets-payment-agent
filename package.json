{
  "name": "gadget-vendor-payment-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch server/src/index.ts",
    "start": "node dist/server/src/index.js",
    "start:prod": "npm run db:migrate:prod && npm run start",
    "db:migrate": "node --import tsx server/src/db/migrate.ts",
    "db:migrate:prod": "node dist/server/src/db/migrate.js",
    "seed": "node --import tsx server/src/db/seed.ts",
    "seed:prod": "node dist/server/src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
